# ============================================================
# Environment variables for GitHub PR Review Orchestrator
# Copy this file to `.env` and fill in real values.
# ============================================================

# --- GitHub App ---
# Numeric App ID from your GitHub App settings
GITHUB_APP_ID=
# Contents of the private key (.pem file) downloaded from GitHub App settings
GITHUB_PRIVATE_KEY=
# Webhook secret (set in GitHub App settings > Webhooks)
GITHUB_WEBHOOK_SECRET=
# Default installation ID for testing — can also be dynamic per webhook
GITHUB_DEFAULT_INSTALLATION_ID=

# --- Redis (Job Queue + LangGraph Checkpoints) ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL (Reports + Call Graph Cache) ---
POSTGRES_URL=postgresql://pr_reviewer:password@localhost:5432/pr_reviewer

# --- Qdrant (Test embeddings for RAG suggestion agent) ---
QDRANT_URL=http://localhost:6333

# --- FastAPI Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Misc ---
# Log level: DEBUG for development
LOG_LEVEL=DEBUG
